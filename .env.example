# =============================================================================
# Configuración de variables de entorno
# Copia este archivo a `.env` y completa tus credenciales:
#   cp .env.example .env
# =============================================================================

# Token del bot de Telegram (obtén el tuyo con @BotFather)
TELEGRAM_BOT_TOKEN=

# Clave API de Google Gemini (desde Google AI Studio)
GOOGLE_API_KEY=

# ID de chat de Telegram del asesor humano al que se escalan consultas
HUMAN_AGENT_CHAT_ID=
